# Скопируй этот файл в .env и заполни своими значениями. .env в git не коммитить.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# ID канала, куда постим (например -1001234567890 или @my_channel, если бот админ канала)
TELEGRAM_CHANNEL_ID=

# Ваш числовой Telegram user ID. Только этот пользователь сможет управлять студией через /start.
TELEGRAM_USER_ID=

# Отбор хайлайтов идёт через локальную Ollama (см. README) — отдельного ключа не нужно.

# Необязательно: бесплатный токен Hugging Face ускоряет первое скачивание Whisper.
# Создайте собственный read-токен. Никогда не публикуйте реальное значение.
HF_TOKEN=
